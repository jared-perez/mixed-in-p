/* Mixed in P stylesheet TEMPLATE.
   Colour placeholders are at-sign-delimited palette token names (BG_DARK,
   NEON_YELLOW, ...). load_stylesheet() in src/gui/app.py substitutes each with
   the active palette's colour (tokens defined in styles/theme.py).
   Do not hardcode hex colours here — add/reuse a palette token instead. */

/* ===== Global ===== */
QWidget {
    background-color: @BG_DARK@;
    color: @TEXT_PRIMARY@;
    /* NOTE: drop platform-specific font families that don't exist on the
       build platform — Qt logs a "Populating font family aliases" warning
       per missing name even when it's listed only as a fallback. Add
       "Segoe UI" back here for the Windows build. */
    font-family: "Helvetica Neue", "Arial", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: @BG_DARK@;
}

/* ===== Frames and Panels ===== */
QFrame {
    background-color: @BG_MEDIUM@;
    border: 1px solid @BG_LIGHT@;
    border-radius: 4px;
}

QFrame#headerBar {
    background-color: @BG_MEDIUM@;
    border: none;
    border-bottom: 1px solid @BG_LIGHT@;
    border-radius: 0px;
}

QFrame#sidebar {
    background-color: @BG_MEDIUM@;
    border: none;
    border-right: 1px solid @BG_LIGHT@;
    border-radius: 0px;
}

QFrame#dropZone {
    background-color: @BG_MEDIUM@;
    border: 2px dashed @TEXT_DISABLED@;
    border-radius: 8px;
}

QFrame#dropZone:hover {
    border-color: @NEON_YELLOW@;
    background-color: @BG_LIGHT@;
}

QFrame#dropZoneActive {
    border: 2px solid @NEON_YELLOW@;
    background-color: @BG_LIGHT@;
}

/* ===== Labels ===== */
QLabel {
    background-color: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
}

QLabel#logoLabel {
    background: transparent;
}

QLabel#sectionTitle {
    font-size: 28px;
    font-weight: bold;
    color: @CHROME@;
    padding: 8px 0px;
}

QLabel#dropZoneLabel {
    color: @TEXT_SECONDARY@;
    font-size: 14px;
}

QLabel#statusQueued {
    color: @CHROME@;
}

QLabel#statusAnalysing {
    color: @NEON_YELLOW@;
}

QLabel#statusAnalysed {
    color: @NEON_GREEN@;
}

QLabel#statusError {
    color: @ERROR@;
}

/* ===== Buttons ===== */
QPushButton {
    background-color: @BG_LIGHT@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BG_LIGHTER@;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background-color: @BG_LIGHTER@;
    border-color: @CHROME@;
}

QPushButton:pressed {
    background-color: @BG_MEDIUM@;
}

QPushButton:disabled {
    background-color: @BG_MEDIUM@;
    color: @TEXT_DISABLED@;
    border-color: @BG_LIGHT@;
}

/* The Discogs tab's per-row "write this into the tags" arrow. A square 24px
   button cannot wear the 8px/16px padding above: a QPushButton centres its
   label rather than eliding it, so 32px of horizontal padding inside a 24px
   button leaves no contents rect at all and the arrow is simply not drawn —
   which reads as an empty box rather than as damage. Stated here rather than
   inline so the palette tokens stay in one file. */
QPushButton#discogsApplyButton {
    padding: 0;
    min-height: 0;
    min-width: 0;
    font-weight: bold;
    color: @ACCENT_TEXT@;
}

QPushButton#discogsApplyButton:disabled {
    color: @TEXT_DISABLED@;
}

/* Header "Add" menu button (QToolButton). Styled here (not via an inline
   setStyleSheet) so the larger font doesn't leak into the button's tooltip/menu,
   which would otherwise render at 16px instead of the default size. QToolButton
   doesn't inherit the QPushButton rules above, so the chrome is restated to
   match the other header buttons. */
QToolButton#headerActionButton {
    background-color: @BG_LIGHT@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BG_LIGHTER@;
    border-radius: 4px;
    /* Extra right padding reserves room for the menu-indicator arrow so it
       doesn't overlap the label. */
    padding: 8px 28px 8px 16px;
    font-size: 16px;
    font-weight: 500;
    min-height: 20px;
}

QToolButton#headerActionButton:hover {
    background-color: @BG_LIGHTER@;
    border-color: @CHROME@;
}

QToolButton#headerActionButton:pressed {
    background-color: @BG_MEDIUM@;
}

QToolButton#headerActionButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
    right: 8px;
}

/* History panel "Show N" menu button (QToolButton). Restates the QPushButton
   chrome (QToolButton doesn't inherit it) so it matches the row's other
   buttons; the extra right padding reserves room for the menu-indicator arrow
   so it never overlaps the number. */
QToolButton#historyLimit {
    background-color: @BG_LIGHT@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BG_LIGHTER@;
    border-radius: 4px;
    padding: 8px 26px 8px 14px;
    font-weight: 500;
    min-height: 20px;
}

QToolButton#historyLimit:hover {
    background-color: @BG_LIGHTER@;
    border-color: @CHROME@;
}

QToolButton#historyLimit:pressed {
    background-color: @BG_MEDIUM@;
}

QToolButton#historyLimit::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
    right: 8px;
}

QPushButton#primaryButton {
    background-color: @NEON_YELLOW@;
    color: @BG_DARK@;
    border: none;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: @ACCENT_HOVER@;
}

QPushButton#primaryButton:pressed {
    background-color: @ACCENT_PRESSED@;
}

QPushButton#primaryButton:disabled {
    background-color: @TEXT_DISABLED@;
    color: @BG_LIGHT@;
}

QPushButton#successButton {
    background-color: @NEON_GREEN@;
    color: @BG_DARK@;
    border: none;
    font-weight: bold;
}

QPushButton#successButton:hover {
    background-color: @ACCENT2_HOVER@;
}

QPushButton#dangerButton {
    background-color: @ERROR@;
    color: @TEXT_PRIMARY@;
    border: none;
    font-weight: bold;
}

QPushButton#dangerButton:hover {
    background-color: @ERROR_HOVER@;
}

/* Cancel button in the Analyze/Convert progress panels. Quiet while idle —
   it sits next to a live progress readout, where a solid red fill reads as an
   error state rather than an available action — and commits to red on hover,
   where the destructive intent belongs. */
QPushButton#cancelButton {
    background-color: transparent;
    color: @TEXT_SECONDARY@;
    border: 1px solid @CHROME_DARK@;
    border-radius: 4px;
    padding: 4px 14px;
    font-weight: 500;
    min-height: 0;
}

QPushButton#cancelButton:hover {
    background-color: @ERROR@;
    color: @TEXT_PRIMARY@;
    border-color: @ERROR@;
}

QPushButton#cancelButton:pressed {
    background-color: @ERROR_HOVER@;
    border-color: @ERROR_HOVER@;
}

/* "Auto" toggle in the Analyze panel header — mirrors the auto-analyze
   setting. Chrome-outlined when off; fills neon yellow when on. */
QPushButton#autoToggle {
    background-color: @BG_MEDIUM@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @CHROME_DARK@;
    border-radius: 4px;
    padding: 6px 18px;
    font-weight: bold;
}

QPushButton#autoToggle:hover {
    border-color: @CHROME@;
    color: @TEXT_PRIMARY@;
}

QPushButton#autoToggle:checked {
    background-color: @NEON_YELLOW@;
    color: @BG_DARK@;
    border-color: @NEON_YELLOW@;
}

QPushButton#autoToggle:checked:hover {
    background-color: @ACCENT_HOVER@;
    border-color: @ACCENT_HOVER@;
}

/* The Convert panel's pipeline toggle — the `|` at the foot of the panel that
   turns Convert into Convert -> Analyze -> playlist. Same on/off colours as
   #autoToggle, because it is the same kind of switch, but its label is one
   glyph and it sits between the stats and the Convert button, so its footprint
   is stated rather than left to the global 8px/16px padding: that padding
   inside a 28px square leaves no contents rect and draws nothing at all (the
   #discogsApplyButton law), and `min-width: 0` alone collapses the button to
   the glyph's own width (the #metroStepButton law). */
QPushButton#pipelineToggle {
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    font-size: 15px;
    font-weight: bold;
    background-color: @BG_MEDIUM@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @CHROME_DARK@;
    border-radius: 4px;
}

QPushButton#pipelineToggle:hover {
    border-color: @CHROME@;
    color: @TEXT_PRIMARY@;
}

QPushButton#pipelineToggle:checked {
    background-color: @NEON_YELLOW@;
    color: @BG_DARK@;
    border-color: @NEON_YELLOW@;
}

QPushButton#pipelineToggle:checked:hover {
    background-color: @ACCENT_HOVER@;
    border-color: @ACCENT_HOVER@;
}

/* The step toggles. PipelineToggle paints its own triangle from Theme tokens,
   so the one thing QSS must do is keep out of the way: no padding (the global
   button padding inside a box this small deletes the glyph — the
   #discogsApplyButton law) and no background, or the global QWidget rule fills
   BG_DARK into the corners the triangle deliberately leaves empty. */
PipelineToggle {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* ...and the header cluster that holds three of them plus the target
   playlist. A bare QWidget used as a layout container is opaque: the global
   QWidget rule fills it BG_DARK, over the header bar it sits on. */
QWidget#pipelineHeaderCluster {
    background-color: transparent;
}

/* "Freeze" toggle beside it — analysis stops writing to disk for the session.
   Same chrome outline when off, but fills WARNING rather than the accent when
   on: "frozen" must not read as one more thing switched on. */
QPushButton#freezeToggle {
    background-color: @BG_MEDIUM@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @CHROME_DARK@;
    border-radius: 4px;
    padding: 6px 18px;
    font-weight: bold;
}

QPushButton#freezeToggle:hover {
    border-color: @CHROME@;
    color: @TEXT_PRIMARY@;
}

QPushButton#freezeToggle:checked {
    background-color: @WARNING@;
    color: @BG_DARK@;
    border-color: @WARNING@;
}

QPushButton#freezeToggle:checked:hover {
    background-color: @WARNING@;
    color: @BG_DARK@;
    border-color: @TEXT_PRIMARY@;
}

QPushButton#sidebarButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    text-align: left;
    /* Left pad halved (6px -> 3px) to pull the icon toward the edge and free up
       horizontal room for long labels (e.g. Russian "Переименовать"). */
    padding: 12px 6px 12px 3px;
    font-size: 16px;
    color: @TEXT_SECONDARY@;
}

/* Collapsed rail: icon only, centred, no label. */
QPushButton#sidebarButton[collapsed="true"] {
    text-align: center;
    padding: 12px 0px;
}

/* Per-button font shrink for a single overlong translated label (set in
   sidebar.py — currently only Russian "Rename"). Keeps every other button at
   16px while letting one outlier fit. */
QPushButton#sidebarButton[compactLabel="true"] {
    font-size: 13px;
}

/* English's labels are short enough to leave the rail under-filled at 16px;
   bump them up so they read more easily (set in sidebar.py only when
   language == "en"). Other languages have longer words and stay at 16px. */
QPushButton#sidebarButton[bigLabel="true"] {
    font-size: 22px;
}

/* German labels are longer (e.g. "Einstellungen"), so they get a smaller bump
   than English but still larger than the 16px default. Set in sidebar.py only
   when language == "de". */
QPushButton#sidebarButton[germanLabel="true"] {
    font-size: 18px;
}

/* Thin divider under the collapse toggle. */
QFrame#sidebarDivider {
    background-color: @BG_LIGHT@;
    border: none;
}

QPushButton#sidebarButton:hover {
    background-color: @BG_LIGHT@;
    color: @TEXT_PRIMARY@;
}

QPushButton#sidebarButton:checked {
    background-color: @BG_LIGHT@;
    color: @NEON_YELLOW@;
    border-left: 3px solid @NEON_YELLOW@;
}

/* Mode-swap containers inside the sidebar. These are plain QWidgets, so the
   global QWidget rule would paint them BG_DARK and hide the sidebar frame's
   own BG_MEDIUM. They are pure layout scaffolding — keep them invisible. */
QStackedWidget#sidebarModeStack,
QWidget#sidebarNavPage,
QWidget#sidebarPlaylistsPage,
QWidget#playlistTreePanel {
    background-color: transparent;
    /* QStackedWidget is a QFrame, so it also picks up the global 1px frame
       border — which draws a box around the whole rail. */
    border: none;
}

/* ===== Metronome (Keyboard panel, third view) ===== */

/* The +/- and bend buttons are 24px square, under the global QPushButton
   padding of 8px/16px — which would leave no contents rect at all and draw
   no glyph (the #discogsApplyButton law).
   The size is STATED here rather than zeroed. `min-width: 0` alone was the
   first attempt and it is worse than the padding: a stylesheet's min-width
   replaces the minimum that setFixedSize(24, 24) set, the size hint then
   collapses to the glyph's own width, and the layout hands the button 9px —
   which renders as a squashed pill with the glyph clipped. Rendered and
   looked at; no test in the suite can see either failure. */
QPushButton#metroStepButton {
    padding: 0;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    font-size: 15px;
    font-weight: bold;
    background-color: @BG_LIGHT@;
    color: @TEXT_PRIMARY@;
    border: none;
    border-radius: 4px;
}

QPushButton#metroStepButton:hover {
    background-color: @NEON_YELLOW@;
    color: @BG_DARK@;
}

QPushButton#metroTapButton,
QPushButton#metroStartButton {
    padding: 4px 14px;
    min-height: 0;
    font-weight: bold;
}

QPushButton#metroStartButton:checked {
    background-color: @NEON_YELLOW@;
    color: @BG_DARK@;
}

/* The tempo, in a monospaced-ish weight so the two decimals do not jitter
   the box width as they change under a drag. */
QLineEdit#metroBpmBox {
    background-color: @BG_DARK@;
    color: @NEON_YELLOW@;
    border: 1px solid @BG_LIGHT@;
    border-radius: 4px;
    font-size: 17px;
    font-weight: bold;
    padding: 0;
}

QLineEdit#metroBpmBox:focus {
    border-color: @NEON_YELLOW@;
}

QWidget#metronomeView {
    background-color: transparent;
}

/* The album-art box at the foot of the rail. A QFrame, so it takes both the
   global QWidget background and the global 1px frame border — neither of
   which belongs behind a picture that fills the whole widget. */
QFrame#sidebarArtBox {
    background-color: transparent;
    border: none;
}

/* Its close button is 18px square, well under the 8px/16px padding the
   global QPushButton rule applies — which would leave no contents rect and
   draw no glyph at all (the #discogsApplyButton law above). The background
   is opaque enough to stay legible over any cover. */
QPushButton#sidebarArtClose {
    padding: 0;
    min-width: 0;
    min-height: 0;
    border: none;
    border-radius: 9px;
    background-color: @BG_DARK@;
    color: @TEXT_PRIMARY@;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#sidebarArtClose:hover {
    background-color: @NEON_YELLOW@;
    color: @BG_DARK@;
}

/* ===== Playlists tree (sidebar playlists mode) ===== */
QTreeView#playlistTree {
    background-color: @BG_MEDIUM@;
    border: none;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

QTreeView#playlistTree::item {
    padding: 5px 2px;
    border-radius: 4px;
}

QTreeView#playlistTree::item:hover {
    background-color: @BG_LIGHT@;
}

QTreeView#playlistTree::item:selected {
    background-color: @BG_LIGHT@;
    color: @NEON_YELLOW@;
}

/* Inline rename editor: the global QLineEdit 8px padding + border leaves a
   ~26px tree row with no room for text (it renders as a squished sliver).
   Slim the chrome so the name is visible while editing. */
QTreeView#playlistTree QLineEdit {
    padding: 1px 4px;
    border-radius: 3px;
    font-size: 14px;
}

/* Compact create buttons above the tree. The recessed fill belongs to the
   buttons themselves, not to the row behind them (which is transparent), so
   the darker tone stops at the button edge instead of banding the sidebar. */
QPushButton#treeCreateButton {
    background-color: @BG_DARK@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BG_LIGHT@;
    border-radius: 4px;
    padding: 5px 6px;
    font-size: 13px;
}

QPushButton#treeCreateButton:hover {
    color: @TEXT_PRIMARY@;
    border-color: @TEXT_SECONDARY@;
    background-color: @BG_LIGHT@;
}

/* Per-row create button, floating at the tree's right edge over the hovered
   row. It carries its own dark chip rather than going transparent: it sits ON
   a row whose hover fill is already BG_LIGHT, and a long name scrolls
   underneath it (the column is ElideNone), so it needs to be opaque to stay
   legible against whatever it lands on. */
QPushButton#treeRowAddButton {
    background-color: @BG_DARK@;
    border: 1px solid @BG_LIGHTER@;
    border-radius: 4px;
    padding: 0px;
    /* The global QPushButton rule's min-height beats setFixedSize (a QSS
       minimum wins over a widget maximum), which stretched an 18px square
       chip to 22px tall. Released here so the size stays the code's to set. */
    min-height: 0px;
}

QPushButton#treeRowAddButton:hover {
    background-color: @BG_LIGHT@;
    border-color: @NEON_YELLOW@;
}

/* Name-filter toggle, in the same row. Borderless and unpadded because this
   row is the narrowest in the app: any width it takes comes out of the two
   translated button labels beside it, which centre-clip rather than elide. */
QPushButton#treeSearchButton {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QPushButton#treeSearchButton:hover {
    background-color: @BG_LIGHT@;
    border-radius: 4px;
}

/* Lit while the box is open, so an open filter is never invisible. */
QPushButton#treeSearchButton:checked {
    background-color: @BG_LIGHT@;
    border-radius: 4px;
}

/* The filter box takes the create buttons' place, so it wears their chrome:
   the global QLineEdit 8px padding would make the row jump taller the moment
   the box opened. */
QLineEdit#treeSearchField {
    padding: 4px 6px;
    border-radius: 4px;
    font-size: 13px;
}

/* ===== Tables ===== */
QTableView, QTableWidget {
    background-color: @BG_MEDIUM@;
    alternate-background-color: @ROW_ALT@;
    border: 1px solid @BG_LIGHT@;
    border-radius: 4px;
    gridline-color: @BG_LIGHT@;
    selection-background-color: @BG_LIGHT@;
    selection-color: @NEON_YELLOW@;
}

QTableView::item, QTableWidget::item {
    padding: 8px;
    border: none;
}

/* History table: trim the horizontal cell padding so timestamps/filenames sit
   close to the column edge (they show in full and scroll rather than eliding). */
QTableWidget#historyTable::item {
    padding: 8px 2px;
}

/* Rename preview table: trim the VERTICAL cell padding so the green "Changed"
   status tag (a cell widget) can fill nearly the full compact row height and
   sit centered, without having to grow the row. Rows stay at their default
   height; only the widget inset shrinks. Keep _STATUS_ITEM_PAD_V in
   rename_panel.py in sync with this value. */
QTableWidget#renamePreviewTable::item {
    padding: 2px 8px;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: @BG_LIGHT@;
    color: @NEON_YELLOW@;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: @ROW_HOVER@;
}

QHeaderView::section {
    background-color: @BG_MEDIUM@;
    color: @CHROME@;
    /* Horizontal padding is deliberately tighter than vertical. A header word
       has to share its section with the sort indicator Qt reserves room for,
       and 8px each side of a 60px Energy column is a quarter of it spent on
       margin — which is what pushed even the English label past its own edge.
       The vertical 8px is what gives the header row its height. */
    padding: 8px 5px;
    border: none;
    border-bottom: 2px solid @BG_LIGHT@;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: @BG_LIGHT@;
}

/* ===== Scroll Bars ===== */
QScrollBar:vertical {
    background-color: @BG_MEDIUM@;
    width: 12px;
    border: none;
    border-radius: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: @BG_LIGHTER@;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: @TEXT_DISABLED@;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* The groove above/below the handle. Windows' style fills these with an opaque
   (white) default that hides the track background; force them transparent so
   the QScrollBar's own background shows through on every platform. */
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: @BG_MEDIUM@;
    height: 12px;
    border: none;
    border-radius: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: @BG_LIGHTER@;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @TEXT_DISABLED@;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* See the vertical add-page/sub-page note above — same Windows white-fill fix. */
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ===== Input Fields ===== */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: @BG_MEDIUM@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BG_LIGHTER@;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: @NEON_YELLOW@;
    selection-color: @BG_DARK@;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: @NEON_YELLOW@;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: @BG_DARK@;
    color: @TEXT_DISABLED@;
}

/* ===== Spin Boxes ===== */
QSpinBox, QDoubleSpinBox {
    background-color: @BG_MEDIUM@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BG_LIGHTER@;
    border-radius: 4px;
    padding: 6px;
    padding-right: 20px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: @NEON_YELLOW@;
}

/* The spin buttons and their arrows are deliberately UNSTYLED — the same rule
   as the combo drop-down below, found the same way. Styling ::up-button /
   ::down-button stops Qt drawing the style's own arrows, and the ::up-arrow /
   ::down-arrow rules that replaced them used the web-CSS triangle trick,
   which Qt's stylesheet engine does not implement: it filled each sub-control
   box with the border colour, so every spin box in the app wore two small
   grey SQUARES. Styling the buttons and dropping only the arrow rules is
   worse still — verified, that draws no arrows at all. Left alone, the
   platform draws real triangles and keeps the field's dark background. */

/* ===== Combo Box ===== */
QComboBox {
    background-color: @BG_MEDIUM@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BG_LIGHTER@;
    border-radius: 4px;
    padding: 8px;
    padding-right: 30px;
}

QComboBox:hover {
    border-color: @CHROME@;
}

QComboBox:focus {
    border-color: @NEON_YELLOW@;
}

/* The drop-down and its arrow are deliberately UNSTYLED, and that is the
   whole rule: the moment a stylesheet gives ::drop-down a width or a border,
   Qt stops drawing the style's own arrow and draws whatever ::down-arrow
   says — and ::down-arrow used to say the web-CSS triangle trick (a zero-size
   box with a thick top border and transparent sides). Qt's stylesheet engine
   does not implement that collapse. It filled the sub-control box with the
   border colour, so every combo in the app wore a small grey RECTANGLE where
   its arrow should be, which users read as an icon rather than as a control.
   Leaving both sub-controls alone gets the platform's own chevron, correct on
   every style and every palette, for no asset and no code. Deleting only
   ::down-arrow is worse than either: a styled ::drop-down with no arrow rule
   draws no arrow at all.

   The corollary is that #compactCombo has no ::drop-down override any more —
   it cannot have one without bringing the rectangle back. It keeps its
   padding, which is where most of its saving came from: the native
   sub-control is roughly half the 30px the old rule reserved, so the "space
   reserved twice" problem it was written for is largely gone with the rule
   that caused it.

   Before trimming this padding any further, note what it is also paying for.
   A combo's POPUP is sized from the combo's frame and comes out narrower than
   it, and each popup row then spends part of what is left on the check column
   beside the current item. So the padding here is the slack the popup borrows,
   and cutting it to 4px is what made all three Convert selectors open onto
   their own labels cut off ("Keep sourc", "24 bit (DVD") in every language.
   That is fixed in the widget, not here — FittedComboBox floors the popup at
   the combo's own width — and it is why every combo in the app is one. */
QComboBox#compactCombo {
    padding: 8px;
    padding-right: 4px;
}

QComboBox QAbstractItemView {
    background-color: @BG_MEDIUM@;
    border: 1px solid @BG_LIGHTER@;
    selection-background-color: @BG_LIGHT@;
    selection-color: @NEON_YELLOW@;
}

/* ===== Progress Bar ===== */
QProgressBar {
    background-color: @BG_MEDIUM@;
    border: 1px solid @BG_LIGHT@;
    border-radius: 4px;
    text-align: center;
    color: @TEXT_PRIMARY@;
    height: 20px;
}

QProgressBar::chunk {
    background-color: @NEON_GREEN@;
    border-radius: 3px;
}

/* ===== Tool Tips ===== */
QToolTip {
    background-color: @BG_MEDIUM@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @NEON_YELLOW@;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ===== Menu ===== */
QMenu {
    background-color: @BG_MEDIUM@;
    border: 1px solid @BG_LIGHT@;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: @BG_LIGHT@;
    color: @NEON_YELLOW@;
}

QMenu::separator {
    height: 1px;
    background-color: @BG_LIGHT@;
    margin: 4px 8px;
}

/* ===== Tab Widget ===== */
/* Transparent and borderless, so the pane does not paint a card over the
   panel's own background the way a bare QWidget container would — the same
   rule the sidebar's stack and the playlist tree panel follow.

   It has to be said HERE rather than on the widget: a `#objectName::pane`
   rule in a widget's own stylesheet does NOT beat this one despite being the
   more specific selector, measured by sampling the rendered pixel (it stayed
   BG_MEDIUM under every spelling tried). What made it look fixed in a quick
   test was the tab *page* painting BG_DARK over the pane — so with the page
   correctly transparent, the pane shows through again. */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabBar::tab {
    background-color: @BG_MEDIUM@;
    color: @TEXT_SECONDARY@;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: @NEON_YELLOW@;
    border-bottom: 2px solid @NEON_YELLOW@;
}

QTabBar::tab:hover:!selected {
    color: @TEXT_PRIMARY@;
}

/* ===== Sliders ===== */
QSlider::groove:horizontal {
    background-color: @BG_MEDIUM@;
    border: 1px solid @BG_LIGHT@;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: @CHROME@;
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: @NEON_YELLOW@;
}

QSlider::sub-page:horizontal {
    background-color: @NEON_YELLOW@;
    border: 1px solid @BG_LIGHT@;
    height: 6px;
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background-color: @BG_MEDIUM@;
    border: 1px solid @BG_LIGHT@;
    height: 6px;
    border-radius: 3px;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: @BG_LIGHT@;
}

/* Handle width is set in code (MainWindow._apply_playlists_splitter): a 2px
   sliver while locked, widening to a comfortable grab target while the
   sidebar is resizable (playlists mode). A QSS width rule here would
   override setHandleWidth(), so only the colors live in the stylesheet. */
QSplitter[playlistsLive="true"]::handle:horizontal {
    background-color: @BG_MEDIUM@;
}

QSplitter[playlistsLive="true"]::handle:horizontal:hover {
    background-color: @NEON_YELLOW@;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: @NEON_YELLOW@;
}

/* ===== Check Box ===== */
QCheckBox {
    spacing: 8px;
    color: @TEXT_PRIMARY@;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid @BG_LIGHTER@;
    border-radius: 3px;
    background-color: @BG_MEDIUM@;
}

QCheckBox::indicator:hover {
    border-color: @CHROME@;
}

QCheckBox::indicator:checked {
    background-color: @NEON_YELLOW@;
    border-color: @NEON_YELLOW@;
}

QCheckBox::indicator:checked:hover {
    background-color: @ACCENT_HOVER@;
    border-color: @ACCENT_HOVER@;
}

/* ===== Radio Button ===== */
QRadioButton {
    spacing: 8px;
    color: @TEXT_PRIMARY@;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid @BG_LIGHTER@;
    border-radius: 10px;
    background-color: @BG_MEDIUM@;
}

QRadioButton::indicator:hover {
    border-color: @CHROME@;
}

QRadioButton::indicator:checked {
    background-color: @BG_MEDIUM@;
    border-color: @NEON_YELLOW@;
}

QRadioButton::indicator:checked::after {
    background-color: @NEON_YELLOW@;
}

/* ===== Group Box ===== */
QGroupBox {
    border: 1px solid @BG_LIGHT@;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: @CHROME@;
    font-weight: bold;
}

/* ===== Status Bar ===== */
QStatusBar {
    background-color: @BG_MEDIUM@;
    border-top: 1px solid @BG_LIGHT@;
    color: @TEXT_SECONDARY@;
}

QStatusBar::item {
    border: none;
}

/* ===== Dialog ===== */
QDialog {
    background-color: @BG_DARK@;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ===== Message Box ===== */
QMessageBox {
    background-color: @BG_DARK@;
}

QMessageBox QLabel {
    color: @TEXT_PRIMARY@;
}
